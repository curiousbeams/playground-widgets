Notebook[{

Cell[CellGroupData[{
Cell["Liquid - Gas Phase Transitions", "Chapter",
 CellChangeTimes->{{3.992488024582432*^9, 
  3.992488036230691*^9}},ExpressionUUID->"3ae41d64-71ea-43f2-b323-\
df0172225a7e"],

Cell["\<\
In 3.020, you have probably covered thermodynamic state variables such as \
pressure, P, temperature, T, and the system\[CloseCurlyQuote]s volume, V.

Equations of state are thermodynamic relations which relate these \
thermodynamic variables, and thus describe the state of a system under these \
physical conditions. They take the general form:\
\>", "Text",
 CellChangeTimes->{{3.992488039904763*^9, 3.992488105144745*^9}, {
  3.99249111171903*^9, 
  3.9924911207011433`*^9}},ExpressionUUID->"6764dfe2-803b-4771-a300-\
c9ad7f04172d"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["f", "TI"], 
       RowBox[{"(", 
         RowBox[{
           StyleBox["P", "TI"], ",", 
           StyleBox["V", "TI"], ",", 
           StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", "0"}], 
     TraditionalForm], "errors" -> {}, "input" -> "f(P,V,T)=0", "state" -> 
   "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",ExpressionUUID->"80be65b1-8f46-4fa8-a1ea-\
27ef17a67a40"],

Cell["\<\
One simple such equation of state, pertaining to non - interacting particles, \
is called the ideal gas law and is given by :\
\>", "Text",
 CellChangeTimes->{{3.992488140025215*^9, 
  3.9924881415138807`*^9}},ExpressionUUID->"294d2543-4c57-4f6b-a013-\
112ccb7ff9a3"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["f", "TI"], 
       RowBox[{"(", 
         RowBox[{
           StyleBox["P", "TI"], ",", 
           StyleBox["V", "TI"], ",", 
           StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
       StyleBox["P", "TI"], 
       StyleBox["V", "TI"], "-", 
       StyleBox["n", "TI"], 
       StyleBox["R", "TI"], 
       StyleBox["T", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
   "errors" -> {}, "input" -> "f(P,V,T)=PV - nRT =0", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",ExpressionUUID->"5476a860-4b46-4dee-9772-\
27c788be1f74"],

Cell["\<\
where n is the number of moles of a substance, and R is the ideal gas constant\
\>", "Text",
 CellChangeTimes->{{3.99248815614686*^9, 3.992488162966748*^9}, {
  3.992491147349936*^9, 3.992491148768037*^9}, {3.99249131052877*^9, 
  3.99249131262733*^9}},ExpressionUUID->"ddd8afc1-3c47-4554-bd45-\
cffa2a85fe65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitConvert", "[", 
    RowBox[{"\"\<MolarGasConstant\>\"", ",", "\"\<SI\>\""}], "]"}], "//", 
   "N"}], "//", "QuantityMagnitude"}]], "Input",
 CellChangeTimes->{{3.992488196064786*^9, 3.992488212114789*^9}, {
  3.992491342526857*^9, 3.992491351467121*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"62eb8f0a-31f0-4a49-92ba-a4ebd51bc775"],

Cell[BoxData["8.31446261815324`"], "Output",
 CellChangeTimes->{{3.9924882056616983`*^9, 3.992488212366848*^9}, 
   3.9924913520183907`*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"5a377d46-f5d9-4af3-953d-67de9bea29d6"]
}, Open  ]],

Cell["\<\
The equation\[CloseCurlyQuote]s simplicity permits thermodynamic development \
without long and tedious equations. 

The ideal gas law, however, has assumptions that are too simple to capture \
the behavior of real systems. Those assumptions are:\
\>", "Text",
 CellChangeTimes->{{3.9924882204152117`*^9, 
  3.992488236687842*^9}},ExpressionUUID->"ca264bc0-5d27-41e7-b2d4-\
f7dcf5073e4a"],

Cell["\<\
 Gas molecules are treated as point particles (occupying no volume)\
\>", "Item",
 CellChangeTimes->{{3.992488238080805*^9, 
  3.99248825126573*^9}},ExpressionUUID->"077a9b75-5f77-4e37-89d1-\
29163a46eada"],

Cell["\<\
Gas molecules are allowed to interact with their container, but not one \
another\
\>", "Item",
 CellChangeTimes->{{3.992488238080805*^9, 
  3.992488253184205*^9}},ExpressionUUID->"dfc2f396-cf39-4ebf-857f-\
4f24472335c6"],

Cell[CellGroupData[{

Cell["Van der Waals Gas", "Section",
 CellChangeTimes->{{3.992488259832211*^9, 
  3.992488263317718*^9}},ExpressionUUID->"bc3f5fef-2ad6-44e8-85d3-\
8fec870da263"],

Cell[TextData[{
 "Replacing these with less simple assumptions gives rise to rich phenomena, \
and in particular phase transitions. Johannes Van der Waals proposed a \
modified equation of state in his thesis which is ",
 ButtonBox["now known as the Van der Waals equation",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Van_der_Waals_equation"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Van_der_Waals_equation"],
 "."
}], "Text",
 CellChangeTimes->{{3.9924882758997583`*^9, 
  3.99248829352873*^9}},ExpressionUUID->"038ce5f3-0d1a-4d15-ac9f-\
320a8a0e5092"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       RowBox[{"(", 
         RowBox[{
           StyleBox["P", "TI"], "+", 
           FractionBox[
            StyleBox["a", "TI"], 
            SuperscriptBox[
             OverscriptBox[
              StyleBox["V", "TI"], "_"], "2"]]}], ")"}], 
       RowBox[{"(", 
         RowBox[{
           OverscriptBox[
            StyleBox["V", "TI"], "_"], "-", 
           StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
       StyleBox["R", "TI"], 
       StyleBox["T", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
   "\\left(P+\\frac{a}{\\bar{V}^2}\\right)\\left(\\bar{V}-b\\right) = RT", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",ExpressionUUID->"f06f3a7f-8b73-4daa-b1f1-\
ead92af6e00d"],

Cell["\<\
where V is the molar volume, and a and b are constants relating to molecular \
interactions and volumes. Note that when both a and b are zero, the van der \
Waals equation reduces to the ideal gas law.\
\>", "Text",
 CellChangeTimes->{{3.9924882994165163`*^9, 3.992488324105741*^9}, {
  3.992491363332582*^9, 
  3.9924913793256598`*^9}},ExpressionUUID->"d92da1e2-b9c5-4e08-bf30-\
0e41ed70b5d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"vdWEquationOfState", "[", 
    RowBox[{"a_", ",", "b_", ",", "r_"}], "]"}], "[", 
   RowBox[{"pressure_", ",", "molarVolume_", ",", "temperature_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"pressure", "+", 
      FractionBox["a", 
       RowBox[{"molarVolume", "^", "2"}]]}], ")"}], 
    RowBox[{"(", 
     RowBox[{"molarVolume", "-", "b"}], ")"}]}], "\[Equal]", 
   RowBox[{"r", " ", "temperature"}]}]}]], "Input",
 CellChangeTimes->{{3.992488333225279*^9, 3.992488335121916*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"686d10e8-d497-499c-b92b-d8856b899e31"],

Cell[CellGroupData[{

Cell["Critical Behaviour", "Subsection",
 CellChangeTimes->{{3.9924883405148287`*^9, 
  3.992488343488893*^9}},ExpressionUUID->"24c77076-5e60-49bd-9830-\
ea1f681aea45"],

Cell[TextData[{
 "Later in 3.020, you will define various thermodynamic relations (Maxwell\
\[CloseCurlyQuote]s relations), and bounds their stability set to materials \
properties. One of these relations, called the ",
 ButtonBox["isothermal bulk modulus",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Bulk_modulus"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Bulk_modulus"],
 " , relates the change in the pressure of material following a change in its \
volume at fixed temperature"
}], "Text",
 CellChangeTimes->{{3.992488349269051*^9, 
  3.9924883717384*^9}},ExpressionUUID->"0ee5df28-34e9-4a61-b8f5-fc7a3360abbf"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubscriptBox[
        StyleBox["K", "TI"], 
        StyleBox["T", "TI"]], "\[LongEqual]", "-", 
       StyleBox["V", "TI"], 
       SubscriptBox[
        RowBox[{
          FractionBox[
           RowBox[{"\[PartialD]", 
             StyleBox["P", "TI"]}], 
           RowBox[{"\[PartialD]", 
             StyleBox["V", "TI"]}]], "\[VerticalSeparator]"}], 
        StyleBox["T", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
   "K_T = -V \\left.\\frac{\\partial P}{\\partial V}\\right|_{T}", "state" -> 
   "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
 CellChangeTimes->{{3.9924883802257843`*^9, 3.9924883807977*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"eeb500a8-84f4-4223-abcd-96aeb45ee8fa"],

Cell["\<\
In stable materials, pressure decreases with increased volume and thus the \
isothermal bulk modulus is positive.  The reasoning goes as follows:\
\>", "Text",
 CellChangeTimes->{
  3.9924883886507797`*^9},ExpressionUUID->"01be9c9c-e11b-4ab9-9625-\
f16efb05ebf2"],

Cell["\<\
 If the bulk modulus becomes negative, then a decrease in volume would be \
resisted by decreasing pressure and the volume would continue to shrink until \
it goes to zero (or the bulk modulus becomes positive). \
\>", "Item",
 CellChangeTimes->{{3.992488408246545*^9, 
  3.992488410203845*^9}},ExpressionUUID->"ebd67e28-ba10-4a3b-9dc6-\
3d4cab225603"],

Cell["\<\
Thus a negative isothermal bulk modules would produce spontaneous volume \
changes \[LongDash] i.e. a phase transition.\
\>", "Item",
 CellChangeTimes->{{3.992488408246545*^9, 
  3.992488416908557*^9}},ExpressionUUID->"5cd631c0-e5e7-4461-9fb2-\
b334d4d04182"],

Cell["Mathematically, we can express this stability condition as ", "Text",
 CellChangeTimes->{
  3.992488425106071*^9},ExpressionUUID->"c81242fe-0746-4a13-87d4-\
a41eab1df4ac"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubscriptBox[
        RowBox[{
          RowBox[{"\[Delta]", 
            StyleBox["V", "TI"], "\[Delta]", 
            StyleBox["P", "TI"]}], "\[VerticalSeparator]"}], 
        StyleBox["T", "TI"]], "<", "0"}], TraditionalForm], "errors" -> {}, 
   "input" -> "\\left.\\delta V \\delta P \\right|_T < 0", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",ExpressionUUID->"bec7ca8b-4caa-4d0c-bd3c-\
960390cd2434"],

Cell["\<\
which highlights that in order for the system to be stable, pressure must \
decrease with increasing volume. For a gas obeying the van der Waals equation \
of state, there exists a critical temperature,Tc , above which eq. (5) is \
always satisfied \[Dash] highlighting the stable region.\
\>", "Text",
 CellChangeTimes->{{3.9924884339891043`*^9, 3.992488439035904*^9}, {
  3.992491168423665*^9, 
  3.992491172469831*^9}},ExpressionUUID->"22236cc8-2ee0-41ba-8f81-\
bfe1f51cd4a7"],

Cell["\<\
In order to find Tc the conditions for a negative slope in pressure versus \
molar volume need to be worked out. As such, we rearrange (3) for pressure:\
\>", "Text",
 CellChangeTimes->{
  3.992488448692037*^9, {3.9924913911672277`*^9, 
   3.992491393419333*^9}},ExpressionUUID->"14d0d89e-87cf-41d4-9bbe-\
367a4f99ddce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"vdWEquationOfStatePressure", "[", 
    RowBox[{"a_", ",", "b_", ",", "r_"}], "]"}], "[", 
   RowBox[{"molarVolume_", ",", "temperature_"}], "]"}], "=", 
  RowBox[{"pressure", "/.", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vdWEquationOfState", "[", 
        RowBox[{"a", ",", "b", ",", "r"}], "]"}], "[", 
       RowBox[{"pressure", ",", "molarVolume", ",", "temperature"}], "]"}], ",",
       "pressure"}], "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"2456ff7e-6186-4316-a172-10c6f2040b24"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "a"}], " ", "b"}], "+", 
   RowBox[{"a", " ", "molarVolume"}], "-", 
   RowBox[{
    SuperscriptBox["molarVolume", "2"], " ", "r", " ", "temperature"}]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"b", "-", "molarVolume"}], ")"}], " ", 
   SuperscriptBox["molarVolume", "2"]}]]], "Output",
 CellChangeTimes->{3.992488466055316*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"7771081d-3750-4427-b1cb-47f97b1a35b5"]
}, Open  ]],

Cell["\<\
We require that the molar volume exhibits an inflection point. This amounts \
to the first and second derivatives (w.r.t. molar volume) vanish.\
\>", "Text",
 CellChangeTimes->{{3.992488472890408*^9, 
  3.9924884791617527`*^9}},ExpressionUUID->"73d9255f-687b-45d0-9523-\
6690a9b1638c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"extremumEquation", "=", 
  RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Derivative", "[", 
       RowBox[{"1", ",", "0"}], "]"}], "[", 
      RowBox[{"vdWEquationOfStatePressure", "[", 
       RowBox[{"a", ",", "b", ",", "r"}], "]"}], "]"}], "[", 
     RowBox[{"vCritical", ",", "tCritical"}], "]"}], "\[Equal]", "0"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"8d9a13cd-3d97-48b9-b440-711f8289d7ed"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    RowBox[{"2", " ", "a", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"b", "-", "vCritical"}], ")"}], "2"]}], "-", 
    RowBox[{"r", " ", "tCritical", " ", 
     SuperscriptBox["vCritical", "3"]}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"b", "-", "vCritical"}], ")"}], " ", "vCritical"}]], "\[Equal]", 
  "0"}]], "Output",
 CellChangeTimes->{3.9924884839754877`*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"dc099703-d3ac-4f11-8256-d385bfcd8e08"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"inflectionEquation", "=", 
  RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Derivative", "[", 
       RowBox[{"2", ",", "0"}], "]"}], "[", 
      RowBox[{"vdWEquationOfStatePressure", "[", 
       RowBox[{"a", ",", "b", ",", "r"}], "]"}], "]"}], "[", 
     RowBox[{"vCritical", ",", "tCritical"}], "]"}], "\[Equal]", "0"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"c5f22332-7f81-4d37-84f0-3b0dc9b06ef5"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    RowBox[{"3", " ", "a", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"b", "-", "vCritical"}], ")"}], "3"]}], "+", 
    RowBox[{"r", " ", "tCritical", " ", 
     SuperscriptBox["vCritical", "4"]}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"b", "-", "vCritical"}], ")"}], " ", "vCritical"}]], "\[Equal]", 
  "0"}]], "Output",
 CellChangeTimes->{3.9924884888575983`*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"0ab11d8e-847f-4cf8-92c7-4d2c006bc5b7"]
}, Open  ]],

Cell["Solving our two equations for the constants a & b", "Text",
 CellChangeTimes->{
  3.992488516092416*^9},ExpressionUUID->"538ede7f-cdb3-4845-917c-\
24f67ac24c09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"criticalSolutionsSubstitutions", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"extremumEquation", ",", "inflectionEquation"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}]}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"c4592cf6-9687-413e-b7e5-25361d0b5a9c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"a", "\[Rule]", 
    FractionBox[
     RowBox[{"9", " ", "r", " ", "tCritical", " ", "vCritical"}], "8"]}], ",", 
   RowBox[{"b", "\[Rule]", 
    FractionBox["vCritical", "3"]}]}], "}"}]], "Output",
 CellChangeTimes->{3.992488521011862*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"b0e83d14-fb32-4012-a967-6d8059cc05bd"]
}, Open  ]],

Cell["\<\
We can express the van der Waals equation of state at the critical point as:\
\>", "Text",
 CellChangeTimes->{
  3.992488525218251*^9},ExpressionUUID->"20f2175f-5d8b-4591-8ba9-\
623cb9020b85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"vdWEquationOfStateCritical", "[", "r_", "]"}], "[", 
   RowBox[{"pCritical_", ",", "vCritical_", ",", "tCritical_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"vdWEquationOfState", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"9", " ", "r", " ", "tCritical", " ", "vCritical"}], "8"], ",", 
     
     FractionBox["vCritical", "3"], ",", "r"}], "]"}], "[", 
   RowBox[{"pCritical", ",", "vCritical", ",", "tCritical"}], 
   "]"}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"93adfe57-6e10-492e-a328-06be78cbc6d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["2", "3"], " ", 
   RowBox[{"(", 
    RowBox[{"pCritical", "+", 
     FractionBox[
      RowBox[{"9", " ", "r", " ", "tCritical"}], 
      RowBox[{"8", " ", "vCritical"}]]}], ")"}], " ", "vCritical"}], "\[Equal]", 
  RowBox[{"r", " ", "tCritical"}]}]], "Output",
 CellChangeTimes->{3.992488529393929*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"6370430e-52c3-4437-9851-d0e41e795692"]
}, Open  ]],

Cell["\<\
In this form, the equation can be solved for any of the critical variables in \
terms of the other two \
\>", "Text",
 CellChangeTimes->{{3.9924885339140387`*^9, 
  3.992488537106146*^9}},ExpressionUUID->"2c17e774-db04-4b15-a550-\
c2685361740e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"criticalVolume", "=", 
  RowBox[{"vCritical", "/.", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vdWEquationOfStateCritical", "[", "r", "]"}], "[", 
       RowBox[{"pCritical", ",", "vCritical", ",", "tCritical"}], "]"}], ",", 
      " ", "vCritical"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"57dd8c86-f06b-4f04-ba75-9efc154d24cd"],

Cell[BoxData[
 FractionBox[
  RowBox[{"3", " ", "r", " ", "tCritical"}], 
  RowBox[{"8", " ", "pCritical"}]]], "Output",
 CellChangeTimes->{3.992488542776775*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"1d14425f-e1b5-496f-91d8-9f4623205fa4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"criticalPressure", "=", 
  RowBox[{"pCritical", "/.", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vdWEquationOfStateCritical", "[", "r", "]"}], "[", 
       RowBox[{"pCritical", ",", "vCritical", ",", "tCritical"}], "]"}], ",", 
      " ", "pCritical"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"fcca4838-1907-4d1f-bad9-033e721895fd"],

Cell[BoxData[
 FractionBox[
  RowBox[{"3", " ", "r", " ", "tCritical"}], 
  RowBox[{"8", " ", "vCritical"}]]], "Output",
 CellChangeTimes->{3.9924885477491617`*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"22d1e574-ad38-4ffc-bfbc-51b2d6bf08b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"criticalTemperature", "=", 
  RowBox[{"tCritical", "/.", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vdWEquationOfStateCritical", "[", "r", "]"}], "[", 
       RowBox[{"pCritical", ",", "vCritical", ",", "tCritical"}], "]"}], ",", 
      " ", "tCritical"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"f983a646-817b-41d4-a836-12f0f09b4871"],

Cell[BoxData[
 FractionBox[
  RowBox[{"8", " ", "pCritical", " ", "vCritical"}], 
  RowBox[{"3", " ", "r"}]]], "Output",
 CellChangeTimes->{3.9924885526040583`*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"b90bde62-48b4-485d-8d1d-9988508bbac7"]
}, Open  ]],

Cell["Using these we can define the following dimensionless ratio:", "Text",
 CellChangeTimes->{
  3.992488561060573*^9},ExpressionUUID->"3b7b80fc-17c7-4be7-9ea1-\
83ebcadc502a"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       FractionBox["3", "8"], "\[LongEqual]", 
       FractionBox[
        RowBox[{
          SubscriptBox[
           StyleBox["P", "TI"], 
           StyleBox["C", "TI"]], 
          SubscriptBox[
           StyleBox["V", "TI"], 
           StyleBox["C", "TI"]]}], 
