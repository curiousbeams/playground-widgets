Cell[CellGroupData[{

Cell["Instability", "Subsection",
 CellChangeTimes->{{3.9924892001513033`*^9, 
  3.9924892017064867`*^9}},ExpressionUUID->"d368d8d3-3c8a-4603-8b8d-\
b08702520046"],

Cell["\<\
Regions of positive slope identify where the system is mechanically unstable. 

Let\[CloseCurlyQuote]s visualize this unstable region by plotting where the \
second derivative changes sign (the spinodal points). There is always one \
spinodal point separating local maxima from minima.\
\>", "Text",
 CellChangeTimes->{{3.992489206224329*^9, 
  3.992489220466846*^9}},ExpressionUUID->"036c3643-d5e9-4e83-a3eb-\
088b09f99092"],

Cell["We use our solution to eliminate the normalized temperature.", "Text",
 CellChangeTimes->{{3.992489228928768*^9, 
  3.9924892310639963`*^9}},ExpressionUUID->"b53ed02f-8bc0-4555-a99d-\
ae69ef017535"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"normalizedTemperatureSubstitution", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"pNormalvdWEquationOfStateNormalized", "[", 
       RowBox[{"vNormalized", ",", "tNormalized"}], "]"}], "==", 
      "pNormalized"}], ",", "tNormalized"}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"6dc7e3cf-7b42-4c46-833c-2de021e01537"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"tNormalized", "\[Rule]", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"3", " ", "vNormalized"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"3", "+", 
       RowBox[{"pNormalized", " ", 
        SuperscriptBox["vNormalized", "2"]}]}], ")"}]}], 
    RowBox[{"8", " ", 
     SuperscriptBox["vNormalized", "2"]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.992489236843058*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"3f53e3e5-6903-438e-8147-f38b4d97c2f9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bulkModulus", "[", 
   RowBox[{"vNormalized_", ",", "pNormalized_"}], "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "vNormalized"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", 
        RowBox[{"1", ",", "0"}], "]"}], "[", 
       "pNormalvdWEquationOfStateNormalized", "]"}], "[", 
      RowBox[{"vNormalized", ",", "tNormalized"}], "]"}]}], "/.", 
    "normalizedTemperatureSubstitution"}], "]"}]}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"a58343b4-6f25-4601-88d2-bbe7715996b9"],

Cell[BoxData[
 FractionBox[
  RowBox[{"3", " ", 
   RowBox[{"(", 
    RowBox[{"2", "-", 
     RowBox[{"3", " ", "vNormalized"}], "+", 
     RowBox[{"pNormalized", " ", 
      SuperscriptBox["vNormalized", "3"]}]}], ")"}]}], 
  RowBox[{
   SuperscriptBox["vNormalized", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"3", " ", "vNormalized"}]}], ")"}]}]]], "Output",
 CellChangeTimes->{3.992489246714418*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"841aaf6e-bf92-4aef-b2f4-8b54bb450a84"]
}, Open  ]],

Cell["\<\
To define the spinodal region as the volumes this crosses the zero point\
\>", "Text",
 CellChangeTimes->{
  3.9924892522810993`*^9},ExpressionUUID->"98713e02-214f-45c6-b470-\
6669d82589b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"spinode", "[", "vNormalized_", "]"}], "=", 
  RowBox[{"pNormalized", "/.", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"bulkModulus", "[", 
        RowBox[{"vNormalized", ",", "pNormalized"}], "]"}], "\[Equal]", "0"}],
       ",", "pNormalized"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"00b67256-4a26-4247-bd28-c9ca019ffbee"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"-", "2"}], "+", 
   RowBox[{"3", " ", "vNormalized"}]}], 
  SuperscriptBox["vNormalized", "3"]]], "Output",
 CellChangeTimes->{3.992489257500802*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"4ee3f41f-ad48-4138-9c89-0d3b67adbd27"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pNormalvdWEquationOfStateNormalized", "[", 
  RowBox[{"vNormalized", ",", "1"}], "]"}]], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"0f3835c9-55ee-43f2-9c9c-1f40f9d1809c"],

Cell[BoxData[
 FractionBox[
  RowBox[{"3", "-", 
   RowBox[{"9", " ", "vNormalized"}], "+", 
   RowBox[{"8", " ", 
    SuperscriptBox["vNormalized", "2"]}]}], 
  RowBox[{
   SuperscriptBox["vNormalized", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"3", " ", "vNormalized"}]}], ")"}]}]]], "Output",
 CellChangeTimes->{3.992489546965214*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"66f1aca8-b238-4cd0-bb5c-11523ba1e54d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{"isothermPlot", ",", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pNormalvdWEquationOfStateNormalized", "[", 
        RowBox[{"vNormalized", ",", "1"}], "]"}], ",", 
       RowBox[{"spinode", "[", "vNormalized", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"vNormalized", ",", "0.5", ",", "4"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "->", "\"\<MintColors\>\""}], ",", 
     RowBox[{"Filling", "->", 
      RowBox[{"{", 
       RowBox[{"2", "->", "Bottom"}], "}"}]}], ",", 
     RowBox[{"FillingStyle", "->", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "\"\<MintColors\>\"", "]"}], "[", "1", 
         "]"}], ",", "0.25"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{"\"\<MintColors\>\"", ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Critical Isotherm, T=1\>\"", 
            ",", "\"\<Spinodal Region\>\""}], "}"}], ",", 
          RowBox[{"LabelStyle", "->", "18"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.7", ",", "0.65"}], "}"}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.992489267358674*^9, 3.992489342146476*^9}, {
